# =============================================================================
#  .gitignore  |  Lokalisierung eines Roboterarms mittels Edge-KI
#  Ziel: schlankes, oeffentliches Repo. Quellcode und Doku ja,
#        Bilder, Trainingsdaten, Modelle und Build-Artefakte nein.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Betriebssystem und Editoren
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# VS Code Projektkonfiguration wird BEWUSST mitgeliefert
# (launch.json, tasks.json, settings.json, c_cpp_properties.json)
# Nur der lokale Zustand fliegt raus:
.vscode/ipch/
.vscode/*.db

# -----------------------------------------------------------------------------
# 2. KI-Assistenten und Tool-Caches
# -----------------------------------------------------------------------------
.claude/
**/.claude/
.cursor/
.aider*
CLAUDE.md
**/CLAUDE.md

# -----------------------------------------------------------------------------
# 3. Bilddateien (keine Bilder im Repo)
# -----------------------------------------------------------------------------
*.png
*.jpg
*.jpeg
*.bmp
*.gif
*.tif
*.tiff
*.webp
*.ppm
*.pgm
*.raw
*.exr
*.psd
*.svg

# Ausnahme: Logos, die KiCad zum Rendern der Schaltplaene braucht
!03_Hardware/**/HKA_Logo*.png
!03_Hardware/**/*Logo*/*.png

# -----------------------------------------------------------------------------
# 4. KI: Trainingsdaten
# -----------------------------------------------------------------------------
**/dataset/
**/datasets/
**/yolo_dataset/
**/pose_dataset/
**/real_dataset/
**/real_pose_dataset/
**/real_yolo_dataset/
**/robot-arm/
**/robot_arm/
**/label_studio_import/
**/winkel_output/
**/labels_backup*/
**/labels_before*/
**/_pdf_pages/
**/.ultralytics_tmp/
labels.csv
**/labels.csv

# -----------------------------------------------------------------------------
# 5. KI: Modelle, Trainingslaeufe und Exporte
# -----------------------------------------------------------------------------
**/Trained_Models/
**/runs/
Edge Export/
**/Edge Export/

*.pt
*.pth
*.onnx
*.tflite
*.h5
*.hdf5
*.pb
*.npz
*.ckpt
*.safetensors
model_weights/
checkpoints/
tensorboard_logs/

# Hinweis: der von STM32Cube AI Studio generierte C-Code unter
# 02_Software/Thesis_Robot_Pose/Appli/AI/generated/ bleibt im Repo,
# weil die Firmware sonst nicht baubar ist. Nur die schweren
# Roh-Artefakte daraus werden ausgeschlossen:
**/AI/generated/*.onnx
**/AI/generated/*.raw
**/AI/generated/*_Q.json
**/AI/generated/*_c_info_generate.json
**/AI/generated/network_generate_report.txt

# -----------------------------------------------------------------------------
# 6. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
.venv/
venv/
env/
.env
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# 7. Embedded: Build-Artefakte
# -----------------------------------------------------------------------------
build/
Build/
Debug/
Release/
.cache/
compile_commands.json
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

*.elf
*.bin
*.hex
*.map
*.o
*.d
*.su
*.a
*.lib
*.list
*.cyclo
*.stldr

# Probe- und Logdateien der Flash-Skripte
stlink_probe.txt
jlink_probe.txt
build_appli.log
*.log
*.history

# -----------------------------------------------------------------------------
# 8. Eclipse / STM32CubeIDE Reste
# -----------------------------------------------------------------------------
.metadata/
**/.metadata/
.project
.cproject
.launch
*.pdom
mx.scratch

# Die .ioc bleibt im Repo, sie ist die Projektquelle fuer CubeMX.

# -----------------------------------------------------------------------------
# 9. TouchGFX
# -----------------------------------------------------------------------------
**/TouchGFX/build/
**/TouchGFX/generated/

# -----------------------------------------------------------------------------
# 10. KiCad und Altium
# -----------------------------------------------------------------------------
*-backups/
**/backups/
*.bak
*-bak
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_prl
fp-info-cache
*.dcm.tmp
*.net.tmp
*.drc.rpt
*.erc.rpt
gerbers/
*.gbr
*.gbrjob
*.drl
*.xln

# Altium Zwischenstaende
*.SchDocPreview
*.PcbDocPreview
History/
Project\ Logs*/

# Referenzdesign MB1940 von ST. Nicht Teil der eigenen Arbeit und
# frei bei ST verfuegbar, daher nicht im Repo.
03_Hardware/Nucleo_PCB_FIles/

