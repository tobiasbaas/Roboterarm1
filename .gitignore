gerbers/
*.gbr
*.drl
*.xln
*.pdf # Wenn Plot-Dateien als PDF exportiert werden

# BOM (Stückliste)
*.xml
*.csv

# KICAD spezifische Backup-Dateien und Logfiles
fp-info-cache
*.dcm.tmp
*.net.tmp
*.drc.rpt
kicad_3dshapes/

# Hardware-Backups und große Archive
*.zip
*.7z
*.rar

